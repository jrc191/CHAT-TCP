<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="400.0" spacing="20.0"
      style="-fx-background-color: white;"
      stylesheets="@chat.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.pspro.chattcpmultisala.cliente.controladores.LoginController">
    <children>

        <!-- Título -->
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="CHAT-TCP" textFill="#5085a8">
                    <font><Font name="System Bold" size="36.0" /></font>
                </Label>
                <Label text="Bienvenido al chat" textFill="#888888">
                    <font><Font size="16.0" /></font>
                </Label>
            </children>
        </VBox>

        <!-- Formulario -->
        <VBox alignment="CENTER" maxWidth="300.0" spacing="16.0">
            <children>

                <!-- Error: invisible Y sin espacio por defecto -->
                <Label fx:id="lblError" textFill="#e74c3c"
                       visible="false" managed="false"
                       wrapText="true" maxWidth="300.0">
                    <font><Font size="12.0" /></font>
                </Label>

                <!-- Campo usuario -->
                <TextField fx:id="txtNombreUsuario"
                           onAction="#onEntrarClick"
                           promptText="Nombre de usuario"
                           styleClass="text-field-round"
                           maxWidth="300.0">
                    <font><Font size="15.0" /></font>
                </TextField>

                <!-- Campo contraseña -->
                <HBox alignment="CENTER_LEFT" maxWidth="300.0" spacing="5.0">
                    <children>
                        <StackPane HBox.hgrow="ALWAYS">
                            <children>
                                <PasswordField fx:id="txtPassword"
                                               onAction="#onEntrarClick"
                                               promptText="Contraseña"
                                               styleClass="text-field-round"
                                               maxWidth="Infinity">
                                    <font><Font size="15.0" /></font>
                                </PasswordField>
                                <TextField fx:id="txtPasswordVisible"
                                           onAction="#onEntrarClick"
                                           promptText="Contraseña"
                                           styleClass="text-field-round"
                                           maxWidth="Infinity"
                                           visible="false">
                                    <font><Font size="15.0" /></font>
                                </TextField>
                            </children>
                        </StackPane>
                        <Button fx:id="btnTogglePassword"
                                onAction="#onTogglePasswordClick"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #5085a8;"
                                text="👁" />
                    </children>
                </HBox>

                <!-- Botón login -->
                <Button fx:id="btnEntrar"
                        maxWidth="300.0" prefHeight="44.0"
                        mnemonicParsing="false"
                        onAction="#onEntrarClick"
                        styleClass="login-button"
                        text="INICIAR SESIÓN">
                    <font><Font name="System Bold" size="14.0" /></font>
                    <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                </Button>

                <!-- Botón registro -->
                <Button fx:id="btnRegistrar"
                        maxWidth="300.0" prefHeight="44.0"
                        mnemonicParsing="false"
                        onAction="#onRegistrarClick"
                        style="-fx-background-color: transparent; -fx-text-fill: #5085a8; -fx-border-color: #5085a8; -fx-border-radius: 22; -fx-background-radius: 22;"
                        text="REGISTRARSE">
                    <font><Font name="System Bold" size="14.0" /></font>
                    <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                </Button>

            </children>
        </VBox>

    </children>
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
    </padding>
</VBox>
