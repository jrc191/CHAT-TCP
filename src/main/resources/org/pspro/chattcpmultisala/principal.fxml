<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    principal.fxml
    Raíz: HBox de 3 columnas.
    · Sidebar     : 280 px fijos
    · Chat        : HBox.hgrow="ALWAYS"  (crece con la ventana)
    · Panel perfil: 300 px, visible=false + managed=false por defecto
                   → no ocupa espacio hasta que se abre con el botón ℹ
-->

<HBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.pspro.chattcpmultisala.cliente.controladores.ChatController"
        stylesheets="@chat.css"
        prefWidth="960"
        prefHeight="640"
        spacing="0">

    <!-- ═══════════════ SIDEBAR (280 px fijo) ═══════════════ -->
    <VBox
            prefWidth="280" minWidth="280" maxWidth="280"
            style="-fx-background-color: #ffffff; -fx-border-color: #e2e2e2; -fx-border-width: 0 1 0 0;">

        <!-- Cabecera perfil propio -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              prefHeight="64" minHeight="64"
              style="-fx-padding: 12 14 12 14; -fx-background-color: #f3f3f3; -fx-border-color: #e2e2e2; -fx-border-width: 0 0 1 0;">
            <Label fx:id="userAvatar" text="U"
                   prefWidth="42" prefHeight="42" minWidth="42" minHeight="42" maxWidth="42" maxHeight="42"
                   alignment="CENTER"
                   style="-fx-background-color: #005f9e; -fx-text-fill: #ffffff; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 21;"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="userName" text="Usuario" maxWidth="Infinity"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a1c1c;"/>
                <Label fx:id="userStatus" text="sin conexión"
                       style="-fx-font-size: 11; -fx-text-fill: #707882;"/>
            </VBox>
            <Button fx:id="cerrarAppBtn" text="✕" onAction="#onCerrarClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #707882; -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 4 8 4 8;"/>
        </HBox>

        <!-- Buscador -->
        <HBox style="-fx-padding: 10 12 8 12;" minHeight="46">
            <TextField fx:id="txtBuscador" promptText="🔍  Buscar..." HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #eeeeee; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: transparent; -fx-padding: 6 12 6 12; -fx-font-size: 13;"/>
        </HBox>

        <!-- Tabs carpetas -->
        <ScrollPane fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                    prefHeight="48" minHeight="44"
                    style="-fx-background-color: transparent; -fx-border-color: #e2e2e2; -fx-border-width: 0 0 1 0; -fx-padding: 0;">
            <content>
                <HBox fx:id="foldersContainer" spacing="4" alignment="CENTER_LEFT"
                      style="-fx-padding: 6 12 6 12;"/>
            </content>
        </ScrollPane>

        <!-- Lista contactos -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
            <content>
                <VBox fx:id="contactList" spacing="0" style="-fx-padding: 4;"/>
            </content>
        </ScrollPane>
    </VBox>

    <!-- ═══════════════ CHAT (crece) ═══════════════ -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #e8e0d8;" spacing="0">

        <!-- Cabecera chat -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              prefHeight="64" minHeight="64"
              style="-fx-padding: 12 16 12 16; -fx-background-color: #ffffff; -fx-border-color: #e2e2e2; -fx-border-width: 0 0 1 0;">
            <Label fx:id="lblTituloChat" text="Sala de Chat General"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity"
                   style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1a1c1c;"/>
            <Button text="ℹ" onAction="#onToggleProfilePanel"
                    style="-fx-background-color: transparent; -fx-text-fill: #005f9e; -fx-font-size: 17; -fx-cursor: hand; -fx-padding: 4 8 4 8;"/>
        </HBox>

        <!-- Historial mensajes -->
        <ScrollPane fx:id="scrollChat" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="chatContainer" spacing="4" style="-fx-padding: 12 16 12 16;"/>
            </content>
        </ScrollPane>

        <!-- Input -->
        <HBox alignment="CENTER" spacing="10"
              prefHeight="62" minHeight="62"
              style="-fx-padding: 10 14 10 14; -fx-background-color: #ffffff; -fx-border-color: #e2e2e2; -fx-border-width: 1 0 0 0;">
            <TextField fx:id="txtMensaje" onAction="#onEnviarClick"
                       promptText="Escribe un mensaje..." HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #eeeeee; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-color: transparent; -fx-padding: 8 14 8 14; -fx-font-size: 14;"/>
            <Button fx:id="btnEnviar" text="➤" onAction="#onEnviarClick"
                    prefWidth="42" prefHeight="42" minWidth="42" minHeight="42"
                    style="-fx-background-color: #005f9e; -fx-background-radius: 21; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- ═══════════════ PANEL PERFIL (oculto por defecto) ═══════════════
         visible="false" managed="false" → ocupa 0px hasta que se activa.
         onToggleProfilePanel() cambia ambas propiedades a true/false.
    ════════════════════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="profilePanel"
                prefWidth="300" minWidth="300" maxWidth="300"
                visible="false" managed="false"
                style="-fx-background-color: #ffffff; -fx-border-color: #e2e2e2; -fx-border-width: 0 0 0 1;">

        <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" spacing="0">

            <!-- Cabecera panel perfil -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  prefHeight="64" minHeight="64"
                  style="-fx-padding: 12 14 12 14; -fx-background-color: #f3f3f3; -fx-border-color: #e2e2e2; -fx-border-width: 0 0 1 0;">
                <Label text="Perfil" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1a1c1c;"/>
                <Button text="✕" onAction="#onToggleProfilePanel"
                        style="-fx-background-color: transparent; -fx-text-fill: #707882; -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 4 8 4 8;"/>
            </HBox>

            <!-- Contenido con scroll -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox spacing="0">

                        <!-- Avatar + nombre -->
                        <VBox alignment="CENTER" spacing="8"
                              style="-fx-padding: 26 20 18 20; -fx-background-color: #f9f9f9; -fx-border-color: #e2e2e2; -fx-border-width: 0 0 1 0;">
                            <Label fx:id="profileAvatarBig" text="U"
                                   prefWidth="80" prefHeight="80" minWidth="80" minHeight="80" maxWidth="80" maxHeight="80"
                                   alignment="CENTER"
                                   style="-fx-background-color: #005f9e; -fx-text-fill: #ffffff; -fx-font-size: 26; -fx-font-weight: bold; -fx-background-radius: 40;"/>
                            <Label fx:id="profileName" text="Usuario" wrapText="true"
                                   alignment="CENTER" maxWidth="Infinity"
                                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1a1c1c;"/>
                            <Label fx:id="profileStatusLabel" text="sin conexión"
                                   style="-fx-font-size: 12; -fx-text-fill: #707882;"/>
                        </VBox>

                        <!-- Teléfono -->
                        <HBox alignment="CENTER_LEFT" spacing="12" minHeight="50"
                              style="-fx-padding: 12 18 12 18; -fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
                            <Label text="📞" style="-fx-font-size: 15; -fx-min-width: 22;"/>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="profilePhone" text="No especificado" wrapText="true"
                                       style="-fx-font-size: 13; -fx-text-fill: #1a1c1c;"/>
                                <Label text="Teléfono" style="-fx-font-size: 11; -fx-text-fill: #707882;"/>
                            </VBox>
                        </HBox>

                        <!-- Email -->
                        <HBox alignment="CENTER_LEFT" spacing="12" minHeight="50"
                              style="-fx-padding: 12 18 12 18; -fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
                            <Label text="✉" style="-fx-font-size: 15; -fx-min-width: 22;"/>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="profileEmail" text="No especificado" wrapText="true"
                                       style="-fx-font-size: 13; -fx-text-fill: #1a1c1c;"/>
                                <Label text="Correo" style="-fx-font-size: 11; -fx-text-fill: #707882;"/>
                            </VBox>
                        </HBox>

                        <!-- Bio -->
                        <HBox alignment="TOP_LEFT" spacing="12" minHeight="50"
                              style="-fx-padding: 12 18 12 18;">
                            <Label text="📝" style="-fx-font-size: 15; -fx-min-width: 22;"/>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="profileBio" text="Sin biografía" wrapText="true"
                                       style="-fx-font-size: 13; -fx-text-fill: #1a1c1c;"/>
                                <Label text="Biografía" style="-fx-font-size: 11; -fx-text-fill: #707882;"/>
                            </VBox>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </AnchorPane>

</HBox>
